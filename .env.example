# Copy to `.env` for local development. Every value here has a working default
# in app/config.py — this file exists to document what is tunable, not to be
# required.

# -- Service ----------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
# Unset means: JSON in staging/production, human-readable text locally.
# LOG_JSON=true

# -- Paths ------------------------------------------------------------------
# Must be a persistent volume in production; holds the SQLite database and the
# derived vector index.
DATA_DIR=./data
DATASET_PATH=./sample_dataset/companies.json

# -- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_ENABLED=true
QUERY_CACHE_SIZE=2048

# Required on hosts whose CPU predates the instruction set the Hugging Face Xet
# download backend is built for; without it the process aborts with SIGILL
# while fetching the model. Harmless everywhere else.
HF_HUB_DISABLE_XET=1

# -- Search tuning ----------------------------------------------------------
CANDIDATE_POOL=400
WEIGHT_KEYWORD=1.0
WEIGHT_VECTOR=1.0
WEIGHT_TOPIC=2.0
RELAXATION_ENABLED=true

# -- Security ---------------------------------------------------------------
# Comma-separated. Empty disables authentication entirely.
API_KEYS=
REQUIRE_AUTH_FOR_READS=false

# -- Limits -----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
REQUEST_TIMEOUT_S=10.0
CORS_ORIGINS=*
